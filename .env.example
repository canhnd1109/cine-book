# API Configuration
NUXT_PUBLIC_BASE_API_URL=http://localhost:8080

# WebSocket URL (will auto-upgrade to wss:// on HTTPS pages)
NUXT_PUBLIC_BASE_SOCKET_URL=ws://localhost:8080

# Production Example
# For production, you can use either ws:// or wss://
# The plugin will automatically upgrade ws:// to wss:// when page is HTTPS
#
# Option 1: Let auto-upgrade handle it
# NUXT_PUBLIC_BASE_SOCKET_URL=ws://cinebook.online/api
#
# Option 2: Explicitly use wss:// (recommended)
# NUXT_PUBLIC_BASE_SOCKET_URL=wss://cinebook.online/api
#
# NUXT_PUBLIC_BASE_API_URL=https://cinebook.online/api

# Location API
NUXT_PUBLIC_BASE_API_LOCATION=https://provinces.open-api.vn/api/v2

# Site Configuration
NUXT_PUBLIC_SITE_URL=https://cinebookmovie.vercel.app
NUXT_PUBLIC_API_BASE=/api
